<?xml version="1.0"?>
<flight_control name="Gnat">

    <property value="0.0">fcs/inputThrottle_nd</property>
    <property value="0.0">fcs/inputPitch_nd</property>
    <property value="0.0">fcs/inputRoll_nd</property>
    <property value="0.0">fcs/inputYaw_nd</property>


    <property value="0.0">fcs/v2_refRoll_rad</property>
    <property value="0.0">fcs/v2_errRoll_rad</property>
    <property value="0.0">fcs/v2_refRoll_rps</property>

    <property value="0.0">fcs/v2_refPitch_rad</property>
    <property value="0.0">fcs/v2_errPitch_rad</property>
    <property value="0.0">fcs/v2_refPitch_rps</property>

    <property value="0.0">fcs/v2_refYaw_rps</property>

    <channel name="OuterLoop-Angles">

        <!-- Pitch  -->

        <pure_gain name="Stick_to_RefPitch">
            <input>fcs/inputPitch_nd</input>
            <gain>-0.65</gain>
            <output>fcs/v2_refPitch_rad</output>
        </pure_gain>

        <summer name="Pitch_Angle_Error">
            <input>fcs/v2_refPitch_rad</input>
            <input>-attitude/pitch-rad</input>
            <output>fcs/v2_errPitch_rad</output>
        </summer>

        <pure_gain name="Pitch_Angle_to_Rate">
            <input>fcs/v2_errPitch_rad</input>
            <gain>2.5</gain>
            <output>fcs/v2_refPitch_rps</output>
        </pure_gain>

        <!-- Roll -->
        <pure_gain name="Stick_to_RefRoll">
            <input>fcs/inputRoll_nd</input>
            <gain>0.75</gain>
            <output>fcs/v2_refRoll_rad</output>
        </pure_gain>

        <summer name="Roll_Angle_Error">
            <input>fcs/v2_refRoll_rad</input>
            <input>-attitude/phi-rad</input>
            <output>fcs/v2_errRoll_rad</output>
        </summer>

        <pure_gain name="Roll_Angle_to_Rate">
            <input>fcs/v2_errRoll_rad</input>
            <gain>2.5</gain>
            <output>fcs/v2_refRoll_rps</output>
        </pure_gain>

        <!-- Yaw -->
        <pure_gain name="Stick_to_RefYaw">
            <input>fcs/inputYaw_nd</input>
            <gain>1.05</gain>
            <output>fcs/v2_refYaw_rps</output>
        </pure_gain>

    </channel>

    <property value="0.0">fcs/v2_errPitch_rps</property>
    <property value="0.0">fcs/v2_cmdPitch_nd</property>

    <property value="0.0">fcs/v2_errRoll_rps</property>
    <property value="0.0">fcs/v2_cmdRoll_nd</property>

    <property value="0.0">fcs/v2_errYaw_rps</property>
    <property value="0.0">fcs/v2_cmdYaw_nd</property>

    <channel name="InnerLoop-Rates">

        <!-- Pitch --> 
        <summer name="Pitch_Rate_Error">
            <input>fcs/v2_refPitch_rps</input>
            <input>-velocities/qi-rad_sec</input>
            <output>fcs/v2_errPitch_rps</output>
        </summer>

        <pid name="Pitch_Rate_PID">
            <input>fcs/v2_errPitch_rps</input>
            <kp>0.2</kp>
            <ki>0.05</ki>
            <kd>0.003</kd>
            <output>fcs/v2_cmdPitch_nd</output>
        </pid>

        <!-- Roll -->
        <summer name="Roll_Rate_Error_Raw">
            <input>fcs/v2_refRoll_rps</input>
            <input>-velocities/pi-rad_sec</input>
            <output>fcs/v2_errRoll_rps</output>
        </summer>

        <pid name="Roll_Rate_PID">
            <input>fcs/v2_errRoll_rps</input>
            <kp>0.2</kp>
            <ki>0.05</ki>
            <kd>0.003</kd>
            <output>fcs/v2_cmdRoll_nd</output>
        </pid>

        <!-- Yaw -->
        <summer name="Yaw_Rate_Error_Raw">
            <input>fcs/v2_refYaw_rps</input>
            <input>-velocities/ri-rad_sec</input>
            <output>fcs/v2_errYaw_rps</output>
        </summer>

        <pid name="Yaw_Rate_PID">
            <input>fcs/v2_errYaw_rps</input>
            <kp>0.2</kp>                                 
            <ki>0.04</ki>
            <kd>0.001</kd>
            <output>fcs/v2_cmdYaw_nd</output>
        </pid>

    </channel>


    <property value="1.5708">fcs/engine_base_pitch_rad</property>
    <property value="0.0">fcs/cmd_engine_FR_nd</property>
    <property value="0.0">fcs/cmd_engine_FL_nd</property>
    <property value="0.0">fcs/cmd_engine_TR_nd</property>
    <property value="0.0">fcs/cmd_engine_TL_nd</property>

    <channel name="Control_Mixer">
 
        <summer name="Mixer_Engine_FR">
            <input>fcs/inputThrottle_nd</input>
            <input>fcs/v2_cmdPitch_nd</input>
            <input>-fcs/v2_cmdRoll_nd</input>
            <output>fcs/cmd_engine_FR_nd</output>
        </summer>

        <summer name="Mixer_Engine_FL">
            <input>fcs/inputThrottle_nd</input>
            <input>fcs/v2_cmdPitch_nd</input>
            <input>fcs/v2_cmdRoll_nd</input>
            <output>fcs/cmd_engine_FL_nd</output>
        </summer>

        <summer name="Mixer_Engine_TR">
            <input>fcs/inputThrottle_nd</input>
            <input>-fcs/v2_cmdPitch_nd</input>
            <input>-fcs/v2_cmdRoll_nd</input>
            <output>fcs/cmd_engine_TR_nd</output>
        </summer>

        <summer name="Mixer_Engine_TL">
            <input>fcs/inputThrottle_nd</input>
            <input>-fcs/v2_cmdPitch_nd</input>
            <input>fcs/v2_cmdRoll_nd</input>
            <output>fcs/cmd_engine_TL_nd</output>
        </summer>

    </channel>

</flight_control>